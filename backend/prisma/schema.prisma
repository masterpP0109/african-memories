generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Activity {
  id             String           @id @default(uuid())
  name           String
  slug           String           @unique
  category       String
  description    String?
  image          String?
  status         ActivityStatus   @default(DRAFT)
  prices         Price[]
  availabilities Availability[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, category, name])
}

enum ActivityStatus {
  DRAFT
  PUBLISHED
}

model Price {
  id         String    @id @default(uuid())
  amount     Decimal   @db.Decimal(10, 2)
  currency   String    @default("USD")
  validFrom  DateTime
  validTo    DateTime
  isActive   Boolean   @default(true)
  activityId String?
  activity   Activity? @relation(fields: [activityId], references: [id])
  createdAt  DateTime  @default(now())

  @@index([activityId, isActive, validFrom])
}

model Availability {
  id         String    @id @default(uuid())
  startsAt   DateTime
  endsAt     DateTime
  capacity   Int
  remaining  Int
  activityId String?
  activity   Activity? @relation(fields: [activityId], references: [id])
  createdAt  DateTime  @default(now())

  @@index([activityId, startsAt])
}
